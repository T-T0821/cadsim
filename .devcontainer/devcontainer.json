{
  "name": "plantwright",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "mounts": [
    // 取ってきた依存クレートをコンテナを作り直しても使い回す (ホストの make docker-<目標> と共有)
    "source=plantwright-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    "source=plantwright-cargo-git,target=/usr/local/cargo/git,type=volume"
  ],
  "containerEnv": {
    "CARGO_TARGET_DIR": "/workspace/target/container"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb"
      ]
    }
  }
}
