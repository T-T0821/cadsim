# 作成: 箱と円柱を追加する
wait_loaded
click "空のプロジェクトから"        # ようこそ画面を閉じて空から始める
wait_loaded
wait 30
click "★ Lv."                     # チュートリアルのカードを閉じる (3D のクリック位置に重なるため)
click "作成"
click "箱を追加"
wait_loaded
wait 420                          # ミッション達成の表示が消えるのを待つ
expect "選択: "
screenshot 01_box

# 穴あけの道具: プロパティの「穴をあける」→ 3D で面をクリック → 点をドラッグ → Enter
click "穴をあける"
wait 10
click "モデル"                     # モデリングパネルを開く (穴あけタブに数値が出る)
wait 10
click "🔍 拡大"                    # 箱を画面いっぱいに
wait 90
drag 600 300 900 500 right        # 少し回して上の面を見やすく
screenshot 02_hole_tool
click_at 740 280                  # 上の面をクリック → 貫通の穴が置かれる
wait 30
expect "(面 #"                      # クリックした面が選ばれた (穴の寸法の文字は 3D に描くので expect では見ない)
screenshot 03_hole_placed
drag 756 286 790 300              # 直径の点をドラッグ
wait 10
drag 738 500 738 420              # 底の点を手前に引いて深さを決める
wait 10
screenshot 04_hole_dragged
key Enter                         # 確定
wait_loaded
wait 60
expect "穴をあけました"
screenshot 05_hole_done

# 形の編集履歴: あけた穴がプロパティに並び、🗑 で消すと箱の形に戻る
expect "形の編集履歴"
expect "穴 φ"
click "🗑"                        # 履歴の穴の行の 🗑 (「🗑 削除」ではなく、文字が同じもの)
wait_loaded
wait 30
expect_not "穴 φ"
screenshot 06_history_removed

# 角を丸める道具: プロパティの「角を丸める」→ 3D で辺をクリック → 矢印の先をドラッグ → Enter
click "角を丸める"
wait 30
screenshot 07_fillet_tool
click_at 900 296                  # 上の面の手前左の辺をクリック
wait 30
expect "辺 1 本"
screenshot 08_fillet_edge
drag 898 297 935 345              # 矢印の先の点を内側へ引いて半径を大きく
wait 30
screenshot 09_fillet_dragged
key Enter                         # 確定
wait_loaded
wait 30
expect "角を丸めました"
screenshot 10_fillet_done

# 肉抜き: 上の面をクリックして開ける面に。穴と丸みのある形は中空にできないので、理由が赤く出る
click "肉抜き"
wait 30
click_at 1090 262                 # 上の面をクリック (開ける面)
wait 30
expect "開ける面 1 枚"
expect "中空にできませんでした"
screenshot 11_shell_error
key Escape                        # 選んだ面を外す
key Escape                        # 道具をやめる
wait 10

click "作成"
click "円柱を追加…"
wait 10
screenshot 02_cylinder_dialog
