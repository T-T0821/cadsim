# 言葉でラインを組む: 文から下書きを作ってモデルに置く (AI なし、キーワードから作る)
wait_loaded
click "空のプロジェクトから"        # ようこそ画面を閉じて空から始める
wait_loaded
wait 30
click "言葉で"                    # 左のツールレール
expect "下書きを作る"
screenshot 01_window

click "コンベア1本、センサー1個、ストッパで外観検査"
click "下書きを作る"
wait_loaded
wait 10
screenshot 02_draft

scroll 550 400 -10                # 置くボタンは下書きの図の下にあるので、パネルを下へスクロールする
wait 10
click "モデルとチャートに置く"
wait_loaded
wait 60
screenshot 03_placed
