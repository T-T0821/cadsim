# 表示: 標準ビュー・平行投影・半透明・3D ビューのクリックで選ぶ
wait_loaded
click "空のプロジェクトから"        # ようこそ画面を閉じて空から始める
wait_loaded
open assets/sample_assembly.step
wait_loaded
wait 60

key 1                            # 正面ビュー
wait 60
screenshot 01_front

click "平行"
wait 30
screenshot 02_ortho

key 0                            # 等角ビュー
click "透視"
wait 60
click "半透明"
screenshot 03_ghost
click "半透明"

# チュートリアルのカードがビューの真ん中に重なるので隠してから、真ん中あたりの部品をクリックして選ぶ
click "隠す"
wait 30
click_at 740 360
expect "選択: "
screenshot 04_picked_in_view
key esc
