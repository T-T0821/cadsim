# 起動: デモラインが動き、ようこそ画面が出る。チュートリアルを始める
wait_loaded
wait 60
expect "ようこそ!"
screenshot 01_welcome

click "▶ チュートリアルを始める"
wait 30
expect_not "ようこそ!"
screenshot 02_tutorial

# ミッション一覧: 基本編・応用編の章が並ぶ。「挑戦」で順番をとばしてカードに出せる
click "▶ 一覧"
wait 10
expect "■ 基本編"                 # 応用編は一覧を下へスクロールすると出る
screenshot 03_mission_list

click "挑戦"                      # 一番上の「挑戦」(ぐるっと見まわそう)
wait 10
screenshot 04_focus_mission
