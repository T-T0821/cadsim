# 動画書き出し: サンプル装置の動きを GIF にする
# 自動確認では保存ダイアログを出さず target/ui-check/07_video/saved/ に書く
wait_loaded
click "空のプロジェクトから"        # ようこそ画面を閉じて空から始める
wait_loaded
wait 30
click "サンプル装置"
click "ファイル"
hover "書き出し"
click "シミュレーションを動画で書き出し…"
expect "● 書き出し開始…"
screenshot 01_settings

click "MP4 (H.264)"              # 形式の選択を開く
click "GIF"
click "1/2"
click "● 書き出し開始…"
wait_loaded
expect "書き出しました:"
screenshot 02_done
