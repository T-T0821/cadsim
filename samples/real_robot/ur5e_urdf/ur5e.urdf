<?xml version="1.0"?>
<!--
  UR5e (Universal Robots) の URDF。plantwright の「ロボット機種 (URDF)」の同梱サンプル。

  Universal_Robots_ROS2_Description (https://github.com/UniversalRobots/Universal_Robots_ROS2_Description)
  の urdf/ur_macro.xacro を ur_type:=ur5e で展開したものと同じリンク・関節・寸法
  (config/ur5e/default_kinematics.yaml、joint_limits.yaml、visual_parameters.yaml) を写し、
  見た目のメッシュ (meshes/ur5e/visual/*.dae) を glTF に変換して同じフォルダに置いた。
  慣性・衝突形状・ros2_control の記述は省いている。
  ライセンス: BSD 3-Clause (../LICENSE-UR5e.txt)
-->
<robot name="UR5e">
  <link name="base_link"/>
  <link name="base_link_inertia">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>
      <geometry><mesh filename="base.glb"/></geometry>
    </visual>
  </link>
  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>
      <geometry><mesh filename="shoulder.glb"/></geometry>
    </visual>
  </link>
  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 0.138" rpy="1.5707963267948966 0 -1.5707963267948966"/>
      <geometry><mesh filename="upperarm.glb"/></geometry>
    </visual>
  </link>
  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 0.007" rpy="1.5707963267948966 0 -1.5707963267948966"/>
      <geometry><mesh filename="forearm.glb"/></geometry>
    </visual>
  </link>
  <link name="wrist_1_link">
    <visual>
      <origin xyz="0 0 -0.127" rpy="1.5707963267948966 0 0"/>
      <geometry><mesh filename="wrist1.glb"/></geometry>
    </visual>
  </link>
  <link name="wrist_2_link">
    <visual>
      <origin xyz="0 0 -0.0997" rpy="0 0 0"/>
      <geometry><mesh filename="wrist2.glb"/></geometry>
    </visual>
  </link>
  <link name="wrist_3_link">
    <visual>
      <origin xyz="0 -0.0005 -0.0989" rpy="1.5707963267948966 0 0"/>
      <geometry><mesh filename="wrist3.glb"/></geometry>
    </visual>
  </link>
  <link name="flange"/>
  <link name="tool0"/>

  <joint name="base_link-base_link_inertia" type="fixed">
    <parent link="base_link"/>
    <child link="base_link_inertia"/>
    <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>
  </joint>
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link_inertia"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.1625" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="150.0" velocity="3.141592653589793"/>
  </joint>
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0" rpy="1.570796327 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="150.0" velocity="3.141592653589793"/>
  </joint>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="-0.425 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="150.0" velocity="3.141592653589793"/>
  </joint>
  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="-0.3922 0 0.1333" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="28.0" velocity="3.141592653589793"/>
  </joint>
  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin xyz="0 -0.0997 -2.044881182297852e-11" rpy="1.570796327 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="28.0" velocity="3.141592653589793"/>
  </joint>
  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin xyz="0 0.0996 -2.042830148012698e-11" rpy="1.570796326589793 3.141592653589793 3.141592653589793"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="28.0" velocity="3.141592653589793"/>
  </joint>
  <joint name="wrist_3-flange" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="flange"/>
    <origin xyz="0 0 0" rpy="0 -1.5707963267948966 -1.5707963267948966"/>
  </joint>
  <joint name="flange-tool0" type="fixed">
    <parent link="flange"/>
    <child link="tool0"/>
    <origin xyz="0 0 0" rpy="1.5707963267948966 0 1.5707963267948966"/>
  </joint>
</robot>
