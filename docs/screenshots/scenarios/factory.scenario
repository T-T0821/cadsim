# 工場: 2 本のラインをフォークリフトでつないだサンプル工場を回し、ラインごとの結果を見る
wait_loaded
click "空のプロジェクトから"
wait_loaded
wait 30
click "★ Lv."                  # ミッションカードを隠す
click "ファイル"
hover "サンプルを開く"
click "工程シミュレーションのサンプル"
wait 10
click "工場"
wait 10
click "サンプル工場"
wait 10
click "工程"
wait 10
scroll 460 500 -6                # 一覧の下のほうの搬送まで送る
wait 10
click "[搬送] フォークリフト"
wait 10
expect "同時に運べる数"
wait 420                         # ミッション達成の表示が消えるのを待つ
screenshot lines
click "⏩ 最後まで"
wait_loaded
wait 30
click "工場"
wait 10
expect "ラインごとの結果"
wait 420                         # ミッション達成の表示が消えるのを待つ
screenshot result
